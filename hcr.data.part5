#. Achievement title for driving 1000km with Race Car
#: src/common/AchievementManager.cpp
msgid "Iceman"
msgstr "Orang Ais"

#. Aerodynamics upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved aerodynamics reduces air resistance and results in higher top speed."
msgstr "Aerodinamik yang dipertingkat mengurangkan rintangan udara dan menghasilkan kelajuan tertinggi."

#. Brake upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved brakes makes car to stop faster. Warning: strong brakes may decrease structural integrity"
msgstr "Brek yang dipertingkat membuatkan kereta berhenti lebih pantas. Amaran: brek yang kuat boleh mengurangkan kelebihan menyokong bebanan"

#. Friction reduction upgrade description (allows the vehicle to move faster)
#: src/common/PlayerCarManager.cpp
msgid "Improved cushion material reduces friction and results in higher ground speed."
msgstr "Bahan kusyen yang dipertingkat mengurangkan geseran dan menghasilkan kelajuan lebih tinggi di tanah."

#. Battery upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved energy efficiency allows the vehicle to driver further with one charge."
msgstr "Kecekapan tenaga dipertingkat membolehkan kenderaan dipandu lebih jauh dengan satu pengecasan."

