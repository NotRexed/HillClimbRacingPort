#: src/common/PlayerCarManager.cpp src/common/PlayerCarManager.cpp
msgid "Improved engine parts result in power increase. Higher horsepower helps you climb hills and make longer jumps and tricks for more bonuses."
msgstr "Bahagian enjin yang dipertingkat menghasilkan peningkatan kuasa. Kuasa kuda leboh besar membantu anda mendaki bukit dan membuat lompatan lebih jauh dan menghasilkan lebih banyak bonus."

#. Engine upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved engine parts result in power increase. Improved engine also weights more."
msgstr "Bahagian enjin yang dipertingkat akan meningkatkan kuasa. Enjin dipertingkat juga bertambah berat."

#: src/common/GarageLocalization.cpp
msgid "Improved gravel tire!"
msgstr "Tayar kelikir dipertingkat!"

#. Tire upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved roll cage material can take more damage before breaking."
msgstr "Bahan kerangka terbina boleh menahan lebih kerosakan sebelum patah."

#. Description for tracks / tires upgrade (improves traction in the tank, snow mobile etc)
#: src/common/PlayerCarManager.cpp
msgid "Improved screw result in better traction and better power delivery to the ground."
msgstr "Skru yang dipertingkat menghasilkan tarikan dan kelancaran lebih baik di atas tanah."

#. Suspension upgrade description
#: src/common/PlayerCarManager.cpp src/common/PlayerCarManager.cpp
#: src/common/PlayerCarManager.cpp src/common/PlayerCarManager.cpp
msgid "Improved shock absorption improves stability at high speeds and makes the car more stable on bumps."
msgstr "Penyerapan hentakan yang dipertingkat meningkatkan keseimbangan pada kelajuan tinggi dan membuatkan kereta lebih stabil pada bonggol."

#. Suspension upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved shock absorption improves stability at high speeds and makes the reindeer more stable on bumps."
msgstr "Penyerapan hentakan yang dipertingkat meningkatkan keseimbangan pada kelajuan tinggi dan membuatkan rusa kutub lebih stabil pada bonggol."

#. Shoes upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved shoes result in better traction and better power delivery to the ground."
msgstr "Kasut yang dipertingkat menghasilkan cengkaman dan penggunaan kuasa bateri lebih baik pada permukaan tanah."

#: src/common/GarageLocalization.cpp
msgid "Improved street tire for asphalt!"
msgstr "Tayar jalanan untuk asfalt dipertingkat!"

#. Thruster upgrade description
#: src/common/PlayerCarManager.cpp
msgid "Improved thruster technology results in better power delivery."
msgstr "Teknologi penujah yang dipertingkat menghasilkan penggunaan kuasa lebih baik."

